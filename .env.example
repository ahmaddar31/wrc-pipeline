# MongoDB
MONGO_URI=mongodb://root:root@localhost:27017/
MONGO_DB=wrc_pipeline
MONGO_LANDING_COLLECTION=landing_metadata
MONGO_PROCESSED_COLLECTION=processed_metadata
MONGO_GOLD_COLLECTION=gold_decisions
MONGO_STATS_COLLECTION=monthly_stats

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_LANDING_BUCKET=wrc-landing
MINIO_PROCESSED_BUCKET=wrc-processed

# Local temp/processed dirs
LOCAL_TMP_DIR=data/tmp
LOCAL_PROCESSED_DIR=data/processed

# Scraper tuning (all optional — defaults are sensible)
SCRAPER_DOWNLOAD_DELAY=1.0
SCRAPER_CONCURRENT_REQUESTS=8
SCRAPER_AUTOTHROTTLE_ENABLED=true

# Alerts (optional — leave blank to disable email alerts)
AIRFLOW_ALERT_EMAIL=

# SMTP for Airflow email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Pipeline
DEFAULT_PARTITION_SIZE=weekly
REQUEST_TIMEOUT_SECONDS=30
RETRY_TIMES=3

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs
APP_ENV=local
